DB_USERNAME=bookstore
DB_PASSWORD=local-bookstore-password
REMEMBER_ME_KEY=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable once to create the first admin; disable after the first successful start.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Local demo returns the reset link in the API response. Use smtp for email delivery.
PASSWORD_RESET_DELIVERY=demo
PASSWORD_RESET_LINK_BASE_URL=http://localhost:8080/api/auth/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@bookstore.local
SMTP_AUTH=true
SMTP_STARTTLS=true
